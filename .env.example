# Copy to .env for local development. Everything here is optional.
# VITE_* values are baked into the built site, so they are public: never put
# a secret in one. For the GitHub Pages build, set them as repository
# variables (Settings -> Secrets and variables -> Actions -> Variables).

# ---------- Forms (contact, manuscript submission, free quote) ----------
# Where the forms POST their JSON. Choose ONE of:
#   a) Web3Forms (free tier): leave VITE_FORM_ENDPOINT empty and set the
#      access key from https://web3forms.com
#   b) Formspree (free tier): VITE_FORM_ENDPOINT=https://formspree.io/f/<form id>
#   c) The Neon handler in server/, deployed on Vercel or Cloudflare Pages:
#      VITE_FORM_ENDPOINT=https://<your-app>.vercel.app/api/queries
#      (or `api/queries` when the site and API are on the same host)
# A path without a leading slash resolves against the site's base path.
# With nothing set, `npm run dev` posts to the local Neon API below, and a
# production build shows visitors a pre-filled email link as a last resort.
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# ---------- Analytics (off when empty) ----------
# G-XXXXXXXXXX -> Google Analytics 4, loaded only after cookie consent.
# example.com  -> Plausible (cookieless). VITE_ANALYTICS_SRC overrides the
#                 script URL for a self-hosted Plausible.
VITE_ANALYTICS_ID=
VITE_ANALYTICS_SRC=

# ---------- Neon API (vite dev, Vercel, Cloudflare Pages) ----------
# Server-side only; never exposed to the browser.
DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require
# Comma-separated origins allowed to POST from another domain, e.g.
# https://prashant-raghav1512.github.io
ALLOWED_ORIGIN=

# ---------- Build ----------
# The path the site is served from. Empty means the domain root (/); set
# /QuillStone/ to build for https://<user>.github.io/QuillStone/.
BASE_PATH=

# The site's public address, no trailing slash. Used for canonical URLs,
# Open Graph tags, structured data, sitemap.xml and robots.txt. Empty means
# https://quillstones.com.
VITE_SITE_URL=
